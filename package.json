{
  "name": "novel-reader-cloudflare-react-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run cf:configure:remote && CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=.wrangler.production.jsonc react-router dev --host 0.0.0.0",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "node scripts/deploy.mjs",
    "typegen": "wrangler types .wrangler/worker-configuration.d.ts && react-router typegen",
    "typecheck": "npm run typegen && tsc -b --noEmit",
    "check": "npm run typecheck && npm run build && wrangler deploy --dry-run",
    "cf:configure": "node scripts/configure-cloudflare.mjs",
    "cf:verify-schema": "node scripts/verify-d1-schema.mjs",
    "db:local:seed": "wrangler d1 execute novel --local --file=scripts/local-d1.sql",
    "test:data": "node --experimental-strip-types tests/repository.test.mjs",
    "test:routes": "node --experimental-strip-types tests/routes.test.mjs",
    "test:security": "node scripts/static-security-check.mjs",
    "test:schema": "python3 tests/schema_consistency.py",
    "test": "npm run test:schema && npm run test:data && npm run test:routes && npm run test:security",
    "cf:configure:remote": "node scripts/configure-cloudflare.mjs --remote"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "@heroicons/react": "2.2.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.140.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
