{
  "name": "novel-reader-cloudflare-react-router",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:local:setup",
    "dev": "react-router dev --host 0.0.0.0",
    "preview": "npm run build && vite preview",
    "deploy": "node scripts/deploy.mjs",
    "typegen": "wrangler types .wrangler/worker-configuration.d.ts && react-router typegen",
    "typecheck": "npm run typegen && tsc -b --noEmit",
    "check": "npm run typecheck && npm run build && wrangler deploy --dry-run",
    "cf:configure": "node scripts/configure-cloudflare.mjs",
    "cf:verify-schema": "node scripts/verify-d1-schema.mjs",
    "db:local:seed": "wrangler d1 execute novel --local --file=scripts/local-d1.sql",
    "test:data": "node --experimental-strip-types tests/repository.test.mjs",
    "test:routes": "node --experimental-strip-types tests/routes.test.mjs",
    "test:security": "node scripts/static-security-check.mjs",
    "test:schema": "python3 tests/schema_consistency.py",
    "test": "npm run test:schema && npm run test:data && npm run test:routes && npm run test:features && npm run test:atlas && npm run test:security",
    "cf:configure:remote": "node scripts/configure-cloudflare.mjs --remote",
    "dev:remote": "npm run cf:configure:remote && CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=.wrangler.production.jsonc react-router dev --host 0.0.0.0",
    "db:import:generate": "node --experimental-strip-types scripts/import-corpus.mjs",
    "db:import:local": "npm run db:import:generate && wrangler d1 execute novel --local --file=.local/corpus.sql",
    "test:features": "node --experimental-strip-types tests/features.test.mjs",
    "test:atlas": "node --experimental-strip-types tests/atlas.test.mjs",
    "test:syntax": "node scripts/syntax-check.mjs",
    "test:e2e": "playwright test",
    "test:core-types": "tsc --noEmit --strict --skipLibCheck --target ES2023 --module ESNext --moduleResolution Bundler --lib ES2023,DOM,DOM.Iterable --allowImportingTsExtensions app/lib/auth.server.ts app/lib/http.server.ts app/lib/bookmarks.server.ts app/lib/chapter-markdown.ts app/lib/atlas.ts app/lib/atlas.server.ts app/lib/reader-state.server.ts app/lib/repository.ts",
    "db:migrate:remote": "node scripts/migrate-d1.mjs --apply",
    "db:migrate:status": "node scripts/migrate-d1.mjs --status",
    "db:verify:readers": "node scripts/migrate-d1.mjs --verify",
    "build": "react-router build",
    "test:d1-migrations": "node --test tests/d1-migrations.test.mjs",
    "test:reader-features": "node --experimental-strip-types --test tests/atlas.test.mjs tests/features.test.mjs tests/d1-migrations.test.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "@heroicons/react": "2.2.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.140.0",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
