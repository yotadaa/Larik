# Shared local SQLite database created by the Python translation pipeline.
DATABASE_PATH=storage/story.sqlite3
DEFAULT_LANG_ID=id

# Reader deployment: reader (default). Translation deployment: translator.
LARIK_APP_MODE=reader

# The translation control UI seeds missing database-backed settings from these values.
# After the first save in /translate, new workers use translation_settings from SQLite.
RAW_STORY_ROOT=story/raw
TRANSLATOR_PYTHON=python
TRANSLATOR_PROJECT_ROOT=
TRANSLATION_LOG_DIR=logs
ADMIN_MAX_PARALLEL_JOBS=2

BASE_URL=http://127.0.0.1:20128/v1
API_KEY=
MODEL=
MAX_TOKENS=49152
CONTEXT_WINDOW=272000
COMPACT_THRESHOLD=0.80
SAFETY_MARGIN_TOKENS=16384
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.5
LLM_TOKEN_PARAMETER=max_tokens
REASONING_EFFORT=max
TRANSLATION_TEMPERATURE=0.15
METADATA_TEMPERATURE=0.05
REPAIR_TEMPERATURE=0.10
PREVIOUS_CHAPTERS=6
PREVIOUS_FULL_CHAPTERS=2
CONTEXT_ENTITY_LIMIT=120
CONTEXT_RELATIONSHIP_LIMIT=160
CONTEXT_TERMINOLOGY_LIMIT=200
CONTEXT_GLOSSARY_LIMIT=100
CONTEXT_ARC_LIMIT=6
QUALITY_REVIEW=adaptive
STRICT_SEQUENTIAL=true
